BOT_TOKEN=replace-with-botfather-token
DATABASE_URL=postgresql+asyncpg://pharmacy:pharmacy@localhost:5432/pharmacy
TERMS_VERSION=2026-07-29
TERMS_URL=https://example.com/terms
PRIVACY_VERSION=2026-07-29
PRIVACY_URL=https://example.com/privacy
LOG_LEVEL=INFO
PRODUCT_QUERY_MIN_LENGTH=2
PRODUCT_QUERY_MAX_LENGTH=160
PRODUCT_URL_MAX_LENGTH=2048
PRODUCT_RESULTS_PAGE_SIZE=5
PRODUCT_DRAFT_TTL_SECONDS=3600
PRODUCT_DISCOVERY_MODE=unavailable
# Comma-separated exact host allowlist. No URL is fetched until a safe source
# adapter is implemented and connected.
SUPPORTED_PRODUCT_HOSTS=
# Optional path to an additional trusted CA certificate, for example in a
# corporate network that performs TLS inspection.
# EXTRA_CA_CERT_PATH=/run/certs/corporate-ca.crt
